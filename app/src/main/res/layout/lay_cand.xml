<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <!-- Rank Circle -->
        <TextView
            android:id="@+id/rankNumber"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="@drawable/bg_rank_circle"/>

        <!-- Avatar -->
        <LinearLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/person_circle"
            android:gravity="center">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/white" />
        </LinearLayout>

        <!-- Name + Match -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/candidateName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sarah Chen"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/text_primary"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ProgressBar
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:progress="95"
                    android:max="100"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:progressTint="@color/primary_blue"
                    android:backgroundTint="#E5E7EB"/>

                <TextView
                    android:id="@+id/matchPercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" 95%"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Skill Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/skillChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="React"
            android:textSize="11sp"
            android:textColor="@color/chip_text"
            app:chipBackgroundColor="@color/chip_bg"
            android:layout_marginEnd="8dp"/>

        <!-- View Profile Button -->
        <Button
            android:id="@+id/viewProfileBtn"
            android:layout_width="110dp"
            android:layout_height="36dp"
            android:text="View Profile"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:background="@drawable/bg_button_blue"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>