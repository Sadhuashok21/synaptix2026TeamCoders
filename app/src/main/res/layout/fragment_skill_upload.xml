<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Your Skills"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter your skills and proficiency level"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:layout_marginBottom="20dp"/>

        <!-- Skill Name -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Skill Name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSkillName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Skill Level -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Skill Level (1-5)"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <Spinner
            android:id="@+id/spSkillLevel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"/>

        <!-- Add Skill Button -->
        <Button
            android:id="@+id/btnAddSkill"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Add Skill"
            android:textAllCaps="false"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary_blue"
            android:textColor="@color/white"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="24dp"/>

        <!-- Saved Skills Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Added Skills"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="20dp"/>

        <!-- Skills List Container -->
        <LinearLayout
            android:id="@+id/skillsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"/>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveSkills"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save Skills"
            android:textAllCaps="false"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_gradient_button"
            android:textColor="@color/white"/>

    </LinearLayout>

</ScrollView>